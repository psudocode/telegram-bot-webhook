# Server Configuration
PORT=3000

# Webhook Configuration (shared for all bots)
WEBHOOK_BASE_URL=https://your-domain.com

# Menfess Bot Configuration
MENFESS_BOT_TOKEN=your_menfess_bot_token_here
MENFESS_WEBHOOK_URI=menfess-webhook
MENFESS_CHANNEL_ID=@your_menfess_channel
MENFESS_HASHTAG=menfess

# Promote Bot Configuration
PROMOTE_BOT_TOKEN=your_promote_bot_token_here
PROMOTE_WEBHOOK_URI=promote-webhook
PROMOTE_CHANNEL_ID=@your_promote_channel
PROMOTE_HASHTAG=promote


# Optional: Secret token for webhook verification (shared for all bots)
WEBHOOK_SECRET=your_webhook_secret_here

# Development (optional)
DEV_RESET_PASSWORD=dev123

# Add more bots by following the pattern above

# Firebase Admin SDK Service Account
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
